# ─── API Keys ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ─── Polymarket CLI ─────────────────────────────────────────────
POLYMARKET_CLI_PATH=polymarket

# ─── Trading Mode ──────────────────────────────────────────────
# Set PAPER_MODE=true for paper trading validation (required for first 14 days)
PAPER_MODE=true
RISK_LEVEL=paper
TOTAL_CAPITAL_USDC=6300

# ─── Glint.trade ───────────────────────────────────────────────
ENABLE_GLINT=true
# Set GLINT_HEADLESS=false for first-time login (manual Google auth)
GLINT_HEADLESS=true
GLINT_DEBUG=false

# ─── Leaderboard ───────────────────────────────────────────────
LEADERBOARD_POLL_MS=300000
LEADERBOARD_TOP_N=20

# ─── Wallet Monitor ────────────────────────────────────────────
WALLET_POLL_MS=30000

# ─── Leader Rotation (Hysteresis) ──────────────────────────────
# Rotate only when challenger leads by >5% for >1 hour
ROTATION_MARGIN_PCT=5
ROTATION_MIN_DURATION_MS=3600000

# ─── Signal Bot (Phase C — Signal v2) ──────────────────────────
# Drop BUY signal trades by default. Set to 'true' to re-enable. The 2026-05-07
# data review showed BUY 1-3d returns were outlier-driven; last 14 days were
# marginal. SELL-only is the primary strategy until a better BUY filter is found.
SIGNAL_BUY_ENABLED=false

# Cap SELL signal trades to markets resolving within this many hours. Long-dated
# SELLs at low entry prices carry asymmetric tail risk that only manifests when
# the stop-loss fires (see 2026-05-07 -$943 BTC trade). Restrict to short-dated
# markets where directional certainty is high.
MAX_HOURS_SELL_RESOLUTION=24

# ─── Risk: SELL-aware position sizing (Phase C addendum, 2026-05-08) ─────
# Floor on entry price for SELL trades. Across 116 historical SELL closures,
# entries below 0.05 produced -$840 cumulative pnl (driven by a single -$943
# event) while the 0.05-0.10 bucket was +$104 with no large losses. This floor
# removes the catastrophic class while preserving the profitable mid-cheap one.
# (BUY uses MIN_SIGNAL_ENTRY_PRICE instead, default 0.03.)
MIN_SELL_ENTRY_PRICE=0.05

# Cap on the max-possible-loss of any single trade as a fraction of current
# balance. For SELL at low entry prices, dollar size dramatically understates
# actual risk: $75 SELL at entry 0.04 carries up to $1,800 max-loss exposure.
# At 0.05 (5%) of a $5,289 balance, the cap is ~$264 max-loss-per-trade —
# loose enough to allow normal SELLs, tight enough to block another -$943
# event. Tunable: lower = stricter, higher = looser. Set to 1.0 to disable.
MAX_LOSS_PCT_PER_TRADE=0.05

# ─── Branch 2: Polygon block listener (shadow mode) ───────────────────
# Subscribes to Polygon newHeads via WSS and decodes matchOrders txs in
# real time, parallel to the existing REST WalletMonitor. The decoded
# trades feed only the DivergenceLogger — they NEVER drive copy or signal
# execution. Promotion criteria: WS recall ≥95% AND median detection
# delta <5s in WS's favor over a 24-48h shadow window. Default OFF.
BLOCK_LISTENER_ENABLED=false

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
