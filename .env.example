# ─── API Keys ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# ─── Polymarket CLI ─────────────────────────────────────────────
POLYMARKET_CLI_PATH=polymarket

# ─── Trading Mode ──────────────────────────────────────────────
# Set PAPER_MODE=true for paper trading validation (required for first 14 days)
PAPER_MODE=true
RISK_LEVEL=paper
TOTAL_CAPITAL_USDC=6300

# ─── Glint.trade ───────────────────────────────────────────────
ENABLE_GLINT=true
# Set GLINT_HEADLESS=false for first-time login (manual Google auth)
GLINT_HEADLESS=true
GLINT_DEBUG=false

# ─── Leaderboard ───────────────────────────────────────────────
LEADERBOARD_POLL_MS=300000
LEADERBOARD_TOP_N=20

# ─── Wallet Monitor ────────────────────────────────────────────
WALLET_POLL_MS=30000

# ─── Leader Rotation (Hysteresis) ──────────────────────────────
# Rotate only when challenger leads by >5% for >1 hour
ROTATION_MARGIN_PCT=5
ROTATION_MIN_DURATION_MS=3600000

# ─── Signal Bot (Phase C — Signal v2) ──────────────────────────
# Drop BUY signal trades by default. Set to 'true' to re-enable. The 2026-05-07
# data review showed BUY 1-3d returns were outlier-driven; last 14 days were
# marginal. SELL-only is the primary strategy until a better BUY filter is found.
SIGNAL_BUY_ENABLED=false

# Cap SELL signal trades to markets resolving within this many hours. Long-dated
# SELLs at low entry prices carry asymmetric tail risk that only manifests when
# the stop-loss fires (see 2026-05-07 -$943 BTC trade). Restrict to short-dated
# markets where directional certainty is high.
MAX_HOURS_SELL_RESOLUTION=24

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=info
